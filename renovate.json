{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "e2e/fixtures/**"
  ],
  "automergeType": "pr-comment",
  "automergeComment": "/merge",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Request non-major merges through csm-ci",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Keep major updates manual",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
